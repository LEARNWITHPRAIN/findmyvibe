# -------------------------------------------------------------
# FIND MY VIBE — Environment Configuration
# Copy this file to .env.local and replace with your actual keys
# -------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Next.js Site URL (for Auth redirect callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin email allowlist (comma-separated, for immediate admin panel access)
ADMIN_EMAILS=admin@csjmu.ac.in,superadmin@findmyvibe.in
